# Google Gemini AI API Key (wajib untuk chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret untuk authentication (wajib)
JWT_SECRET=your_secure_jwt_secret_here

# Database PostgreSQL (opsional, fallback ke in-memory jika tidak ada)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gpdi_melati
